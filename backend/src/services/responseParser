/**
 * Extract mix design data from AI's text response and remove the JSON from the text
 */
function parseMixDesignResponse(text) {
  let jsonString = null;
  let cleanText = text; // This will hold the text without the JSON block

  // 1. First, try to find the <pdf_data> tags
  const tagMatch = text.match(/<pdf_data>([\s\S]*?)<\/pdf_data>/i);
  if (tagMatch && tagMatch[1]) {
    jsonString = tagMatch[1];
    // Remove the tags and JSON from the text shown to the user
    cleanText = text.replace(tagMatch[0], '').trim(); 
  } else {
    // 2. BACKUP: Look for a JSON object at the very end of the text.
    // Updated regex to catch it if the AI only outputs {"location": "..."} OR the full mix design.
    const bracketMatch = text.match(/(\{\s*(?:"mix_design"|"location")[\s\S]*\})\s*$/i);
    if (bracketMatch && bracketMatch[1]) {
      jsonString = bracketMatch[1];
      // Remove the JSON block from the text shown to the user
      cleanText = text.replace(bracketMatch[1], '').trim();
    }
  }

  // Safely parse the JSON if found
  let parsedData = {};
  if (jsonString) {
    try {
      parsedData = JSON.parse(jsonString.trim());
    } catch (err) {
      console.error('Failed to parse AI JSON block', { error: err.message });
    }
  }

  // Extract the location from the JSON (if it exists)
  let extractedLocation = parsedData.location || null;

  // 3. FALLBACK: Regex logic just in case the JSON is completely missing
  const design = { materials: {}, ratios: {} };
  const tableRegex = /\|\s*([^|]+)\s*\|\s*([^|]+)\s*\|/g;
  let match;
  
  while ((match = tableRegex.exec(cleanText)) !== null) {
    const label = match[1].trim().toLowerCase();
    const rawValue = match[2].trim().replace(/[*`~]/g, '');
    const numMatch = rawValue.match(/[0-9.]+/);
    const num = numMatch ? parseFloat(numMatch[0]) : null;

    if (num !== null) {
      if (label.includes('cement') && !label.includes('content') && !label.includes('ratio')) design.materials.cement = num;
      else if (label.includes('water') && !label.includes('ratio')) design.materials.water = num;
      else if (label.includes('fine aggregate') || label.includes('sand')) design.materials.fine_aggregate = (design.materials.fine_aggregate || 0) + num;
      else if (label.includes('coarse aggregate') || label.includes('gravel')) design.materials.coarse_aggregate = (design.materials.coarse_aggregate || 0) + num;
      else if (label.includes('w/c')) design.ratios.w_c_ratio = num;
      else if (label.includes('air content')) design.ratios.air_content = num;
    }
  }

  // Fallback location extraction if it wasn't in the JSON
  if (!extractedLocation) {
    const locationMatch = cleanText.match(/Location:\s*(.+)/i);
    if (locationMatch) {
        extractedLocation = locationMatch[1].trim().replace(/\.$/, '').replace(/[*`~]/g, '');
        // Clean up any trailing vertical bars from markdown tables
        extractedLocation = extractedLocation.split('|')[0].trim();
    }
  }

  const mix_design = parsedData.mix_design || {};

  return {
    // Use this clean_text property to display the message to your users!
    clean_text: cleanText, 
    format: jsonString ? 'json_extracted' : 'fallback_regex',
    
    // Core data
    location: extractedLocation,
    mix_design: mix_design,
    compliance: parsedData.compliance || { code: "Unknown", checks: [] },
    qa_notes: parsedData.qa_notes || null,
    field_tips: parsedData.field_tips || [],
    justification: parsedData.justification || {},
    
    // Old structure for backwards compatibility
    materials: {
      cement: mix_design.cement || design.materials.cement,
      water: mix_design.water || design.materials.water,
      fine_aggregate: mix_design.fine_aggregate || design.materials.fine_aggregate,
      coarse_aggregate: mix_design.coarse_aggregate || design.materials.coarse_aggregate,
      ...(mix_design.admixtures || {})
    },
    ratios: {
      w_c_ratio: mix_design.w_c_ratio || design.ratios.w_c_ratio,
      target_mean_strength: mix_design.target_mean_strength,
      air_content: mix_design.air_content || design.ratios.air_content
    },
    clarifications: []
  };
}

module.exports = { parseMixDesignResponse };