/**
 * Extract mix design data from Claude's text response
 */
function parseMixDesignResponse(text) {
  let jsonString = null;

  // 1. First, try to find the <pdf_data> tags
  const tagMatch = text.match(/<pdf_data>([\s\S]*?)<\/pdf_data>/i);
  if (tagMatch && tagMatch[1]) {
    jsonString = tagMatch[1];
  } else {
    // 2. BACKUP: If Claude forgot the tags, look for a large JSON object at the very end of the text
    const bracketMatch = text.match(/(\{\s*"mix_design"[\s\S]*\})\s*$/i);
    if (bracketMatch && bracketMatch[1]) {
      jsonString = bracketMatch[1];
    }
  }

  if (jsonString) {
    try {
      const parsedData = JSON.parse(jsonString.trim());
      const mix_design = parsedData.mix_design || {};
      
      return {
        format: 'json_extracted',
        mix_design: mix_design,
        compliance: parsedData.compliance || {},
        qa_notes: parsedData.qa_notes || null,
        field_tips: parsedData.field_tips || null,
        justification: parsedData.justification || {},
        location: parsedData.location || null,
        
        // Old structure for backwards compatibility
        materials: {
          cement: mix_design.cement,
          water: mix_design.water,
          fine_aggregate: mix_design.fine_aggregate,
          coarse_aggregate: mix_design.coarse_aggregate,
          ...(mix_design.admixtures || {})
        },
        ratios: {
          w_c_ratio: mix_design.w_c_ratio,
          target_mean_strength: mix_design.target_mean_strength,
          air_content: mix_design.air_content
        },
        clarifications: []
      };
    } catch (err) {
      logger.error('Failed to parse AI JSON block', { error: err.message });
    }
  }

  // 2. FALLBACK: Old regex logic if Claude forgets the JSON block
  const design = { format: 'markdown', materials: {}, ratios: {}, location: null };
  const tableRegex = /\|\s*([^|]+)\s*\|\s*([^|]+)\s*\|/g;
  let match;
  
  while ((match = tableRegex.exec(text)) !== null) {
    const label = match[1].trim().toLowerCase();
    const rawValue = match[2].trim().replace(/[*`~]/g, '');
    const numMatch = rawValue.match(/[0-9.]+/);
    const num = numMatch ? parseFloat(numMatch[0]) : null;

    if (num !== null) {
      if (label.includes('cement') && !label.includes('content') && !label.includes('ratio')) design.materials.cement = num;
      else if (label.includes('water') && !label.includes('ratio')) design.materials.water = num;
      else if (label.includes('fine aggregate') || label.includes('sand')) design.materials.fine_aggregate = (design.materials.fine_aggregate || 0) + num;
      else if (label.includes('coarse aggregate') || label.includes('gravel')) design.materials.coarse_aggregate = (design.materials.coarse_aggregate || 0) + num;
      else if (label.includes('w/c')) design.ratios.w_c_ratio = num;
      else if (label.includes('air content')) design.ratios.air_content = num;
    }
  }

  const locationMatch = text.match(/Location:\s*(.+)/i);
  if (locationMatch) design.location = locationMatch[1].trim().replace(/\.$/, '').replace(/[*`~]/g, '');

  return {
    format: 'fallback_regex',
    // New structure
    mix_design: { ...design.materials, ...design.ratios },
    compliance: { code: "Unknown", checks: [] },
    qa_notes: null,
    field_tips: [],
    justification: {},
    location: design.location,
    // Old structure (Backwards compatibility)
    materials: design.materials,
    ratios: design.ratios,
    clarifications: []
  };
}

module.exports = { parseMixDesignResponse };