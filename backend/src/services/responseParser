/**
 * Extract mix design data from AI's text response using XML tags (Handles JSON at the TOP)
 */
function parseMixDesignResponse(text) {
  const startTag = '<pdf_data>';
  const endTag = '</pdf_data>';
  
  const startIdx = text.toLowerCase().indexOf(startTag);
  const endIdx = text.toLowerCase().indexOf(endTag);

  if (startIdx === -1 || endIdx === -1) {
    throw new Error('PDF Data tags missing from AI response');
  }

  const jsonString = text.substring(startIdx + startTag.length, endIdx).trim();
  
  try {
    const parsedData = JSON.parse(jsonString);
    
    // Validate that we actually got data
    if (!parsedData.mix_design) throw new Error('Incomplete JSON data');

    return {
      clean_text: text.replace(text.substring(startIdx, endIdx + endTag.length), '').trim(),
      mix_design: parsedData.mix_design,
      compliance: parsedData.compliance,
      qa_notes: parsedData.qa_notes,
      field_tips: parsedData.field_tips,
      justification: parsedData.justification,
      location: parsedData.location
    };
  } catch (err) {
    // THROWING here is key - it stops the PDF generation from happening with bad data
    throw new Error('Failed to parse AI JSON: ' + err.message);
  }
}
module.exports = { parseMixDesignResponse };