/**
 * Extract mix design data from AI's text response and safely strip the JSON from the UI text
 */
function parseMixDesignResponse(text) {
  let jsonString = null;
  let cleanText = text; 

  // 1. Ideal Case: It's wrapped in <pdf_data> tags
  const tagMatch = text.match(/<pdf_data>([\s\S]*?)<\/pdf_data>/i);
  
  // 2. Markdown Case: AI wrapped it in ```json ... ```
  const mdMatch = text.match(/```(?:json)?\s*(\{[\s\S]*?"mix_design"[\s\S]*?\})\s*
```/i);

  if (tagMatch) {
    jsonString = tagMatch[1];
    cleanText = text.replace(tagMatch[0], '').trim();
  } else if (mdMatch) {
    jsonString = mdMatch[1];
    cleanText = text.replace(mdMatch[0], '').trim();
  } else {
    // 3. BULLETPROOF RAW JSON EXTRACTOR:
    // Finds the very first '{' and the very last '}' in the AI's response
    const firstBrace = text.indexOf('{');
    const lastBrace = text.lastIndexOf('}');
    
    if (firstBrace !== -1 && lastBrace !== -1 && firstBrace < lastBrace) {
      const potentialJson = text.substring(firstBrace, lastBrace + 1);
      
      // Make sure it's actually our mix design JSON
      if (potentialJson.includes('"mix_design"')) {
        try {
          // Verify it parses perfectly
          JSON.parse(potentialJson);
          jsonString = potentialJson;
          
          // Completely remove the JSON block from the text the user sees
          cleanText = text.replace(potentialJson, '').trim();
        } catch (err) {
          // If JSON parse fails, it skips stripping to avoid deleting chat text
          console.error('JSON Extraction fallback failed:', err.message);
        }
      }
    }
  }

  // Strip rogue markdown backticks if they leaked in
  if (jsonString) {
    jsonString = jsonString.replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/i, '').trim();
  }

  // Safely parse the JSON if found
  let parsedData = {};
  if (jsonString) {
    try {
      parsedData = JSON.parse(jsonString);
    } catch (err) {
      console.error('Failed to parse AI JSON block', { error: err.message });
    }
  }

  // Extract the location from the JSON or text
  let extractedLocation = parsedData.location || null;
  if (!extractedLocation) {
    const locationMatch = cleanText.match(/Location:\s*(.+)/i);
    if (locationMatch) {
        extractedLocation = locationMatch[1].trim().replace(/\.$/, '').replace(/[*`~]/g, '');
        extractedLocation = extractedLocation.split('|')[0].trim();
    }
  }

  const mix_design = parsedData.mix_design || {};

  return {
    // 🟢 THIS GOES TO THE USER CHAT UI
    clean_text: cleanText,
    format: jsonString ? 'json_extracted' : 'fallback_regex',

    // 🔵 THIS GOES TO YOUR PDF SERVICE
    location: extractedLocation,
    mix_design: mix_design,
    compliance: parsedData.compliance || { code: "Unknown", checks: [] },
    qa_notes: parsedData.qa_notes || null,
    field_tips: parsedData.field_tips || [],
    justification: parsedData.justification || {},

    // Old structure for backwards compatibility
    materials: {
      cement: mix_design.cement,
      water: mix_design.water,
      fine_aggregate: mix_design.fine_aggregate,
      coarse_aggregate: mix_design.coarse_aggregate,
      ...(mix_design.admixtures || {})
    },
    ratios: {
      w_c_ratio: mix_design.w_c_ratio,
      target_mean_strength: mix_design.target_mean_strength,
      air_content: mix_design.air_content
    },
    clarifications: []
  };
}

module.exports = { parseMixDesignResponse };